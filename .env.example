# ============================================================
# HostBot - configuration template
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHI...   # from @BotFather
OWNER_ID=0                                   # your telegram numeric id
ADMIN_ID=0                                   # co-admin numeric id (optional)
YOUR_USERNAME=@yourusername
UPDATE_CHANNEL=https://t.me/yourchannel

# --- MPX AI assistant (/mpx command) ---
A4F_API_URL=https://samuraiapi.in/v1/chat/completions
A4F_API_KEY=sk-your-api-key
A4F_MODEL=provider10-claude-sonnet-4-20250514(clinesp)

# --- Storage ---
# VPS/Docker: /data   |   Local: ./data
DATA_DIR=./data

# --- Optional status server (feeds the Vercel landing page) ---
# Set true to expose GET /health and /stats on STATUS_SERVER_PORT
STATUS_SERVER_ENABLED=false
STATUS_SERVER_PORT=9090
STATUS_TOKEN=optional-bearer-token