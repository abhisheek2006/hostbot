# ============================================================
# HostBot - configuration template
# Copy to .env and fill in real values. NEVER commit .env
# NOTE: no inline comments after values - some parsers
# (systemd EnvironmentFile) do not strip them.
# ============================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHI...
OWNER_ID=0
ADMIN_ID=0
YOUR_USERNAME=@yourusername
UPDATE_CHANNEL=https://t.me/yourchannel

# --- MPX AI assistant (/mpx command) ---
A4F_API_URL=https://samuraiapi.in/v1/chat/completions
A4F_API_KEY=sk-your-api-key
A4F_MODEL=provider10-claude-sonnet-4-20250514(clinesp)

# --- Storage ---
# VPS/Docker: /data   |   Local: ./data
DATA_DIR=./data

# --- MongoDB (required - plans, users, files, approvals) ---
# Connection string from MongoDB Atlas
MONGO_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/
MONGO_DB_NAME=hostbot

# --- Hosting plans ---
# Free users can host FREE_BOT_LIMIT bots. Paid plans allow more.
FREE_BOT_LIMIT=3
SUBSCRIBED_USER_LIMIT=15
PLAN_STARTER_LIMIT=8
PLAN_PRO_LIMIT=20
PLAN_BUSINESS_LIMIT=50

# --- Optional status server (feeds the Vercel landing page + dashboard API) ---
# Set true to expose /health, /stats, /api/plans and the login/dashboard API
STATUS_SERVER_ENABLED=false
STATUS_SERVER_PORT=9090
# Optional bearer token protecting /health and /stats
STATUS_TOKEN=optional-bearer-token

# --- Web dashboard logins ---
# Single admin login (maps to OWNER_ID when WEB_OWNER_ID is not set):
WEB_USERNAME=admin
WEB_PASSWORD=change-this-password
# Telegram id this single login maps to (defaults to OWNER_ID)
# WEB_OWNER_ID=0
# Multiple logins, semicolon separated (overrides the single login above):
# WEB_USERS=admin:pass123:123456789;alice:alicepass:987654321
# Seconds a login lasts (default 24h)
WEB_SESSION_TTL=86400